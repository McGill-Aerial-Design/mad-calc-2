variables {
  span = 1.5
  dihedralRatio = 1/8
  sweepRatio = 1/3
  twist = 5
  elevator = 0
  trim = -2
}

wing {
  # right wing
  profile = NACA4412
  flapHinge = 0.8, 0.5
  flapang = -y/(span/2)*20
  span = span/2
  chord = 0.5-0.1*y
  dihedral = dihedralRatio*y
  sweep = sweepRatio*y
  twist = (span/2-y)/(span/2)*twist
  reflect = False
  inverted = False
  numElements = 15
  position = 0, 0.2, 0
}

wing {
  # left wing
  profile = NACA4412
  flapHinge = 0.8, 0.5
  flapang = -y/(span/2)*20
  span = span/2
  chord = 0.5-0.1*y
  dihedral = dihedralRatio*y
  sweep = sweepRatio*y
  twist = (span/2-y)/(span/2)*twist
  reflect = True
  inverted = False
  numElements = 15
  position = 0, -0.2, 0
}

wing {
  # right stablizer
  profile = NACA4412
  flapHinge = 0.8, 0.5
  flapang = elevator
  span = span/6
  chord = 0.3-0.1*y
  dihedral = 0
  sweep = 0.1*y
  twist = trim
  reflect = False
  inverted = True
  numElements = 15
  position = 1, 0.1, 0
}

wing {
  # left stablizer
  profile = NACA4412
  flapHinge = 0.8, 0.5
  flapang = elevator
  span = span/6
  chord = 0.3-0.1*y
  dihedral = 0
  sweep = 0.1*y
  twist = trim
  reflect = True
  inverted = True
  numElements = 15
  position = 1, -0.1, 0
}

mass {
  mass = 1
  position = 0.1, span/4, 0
}

mass {
  mass = 1
  position = 0.1, -span/4, 0
}


